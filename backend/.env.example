DATABASE_URL=mysql://usuario:senha@localhost/agrovia
# Produção: host MySQL remoto fornecido pela instituição; não use localhost.
# DB_HOST/DB_USER/DB_PASS/DB_NAME não são lidos pela aplicação.
# Porta padrão: 3306. Codifique caracteres especiais de usuário/senha na URL.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
AUTH_TOKEN_SECRET=
TZ=America/Sao_Paulo

# Seed manual de conta TECNICO. Nunca executar no build/start.
# A senha deve ter 12 a 128 caracteres, sem espaços nas extremidades.
SEED_TECNICO_EMAIL=
SEED_TECNICO_NOME=Técnico Agrovia
SEED_TECNICO_SENHA=

# SMTP necessário para habilitar o envio automático de relatórios por e-mail.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario-smtp
# SMTP_PASS=senha-de-aplicativo
# SMTP_FROM=Agrovia <relatorios@exemplo.com>
