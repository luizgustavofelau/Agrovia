# Banco MySQL/MariaDB: use UMA das duas formas abaixo (DATABASE_URL tem prioridade).
# Produção: host MySQL remoto fornecido pela instituição; não use localhost.
#
# Forma 1 — variáveis separadas (formato da hospedagem; senha sem codificação):
DB_HOST=host-do-banco
DB_USER=usuario
DB_PASS=senha
DB_NAME=nome-do-banco
DB_PORT=3306
#
# Forma 2 — URL única. Codifique caracteres especiais (@ vira %40, # vira %23):
# DATABASE_URL=mysql://usuario:senha@host/nome-do-banco
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Caminho público do site (homepage do frontend), usado no link de redefinição de senha.
FRONTEND_BASE_PATH=/tecti/2026/gpec05
AUTH_TOKEN_SECRET=
TZ=America/Sao_Paulo

# Seed manual de conta TECNICO. Nunca executar no build/start.
# A senha deve ter ao menos 12 caracteres e no máximo 72 bytes UTF-8, sem espaços nas extremidades.
SEED_TECNICO_EMAIL=
SEED_TECNICO_NOME=Técnico Agrovia
SEED_TECNICO_SENHA=

# SMTP necessário para o envio de relatórios automáticos e dos links de redefinição de senha.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario-smtp
# SMTP_PASS=senha-de-aplicativo
# SMTP_FROM=Agrovia <relatorios@exemplo.com>
