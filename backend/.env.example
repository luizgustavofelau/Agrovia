DATABASE_URL=mysql://usuario:senha@localhost/agrovia
# Porta padrão: 3306. Codifique caracteres especiais de usuário/senha na URL.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
AUTH_TOKEN_SECRET=
TZ=America/Sao_Paulo

# SMTP necessário para habilitar o envio automático de relatórios por e-mail.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario-smtp
# SMTP_PASS=senha-de-aplicativo
# SMTP_FROM=Agrovia <relatorios@exemplo.com>